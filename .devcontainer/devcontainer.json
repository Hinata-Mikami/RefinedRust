{
    "name": "RefinedRust devcontainer",
    "image": "refinedrust-devcontainer:latest",

    "customizations": {
        "vscode": {
            "extensions": [ "rocq-prover.vsrocq" ],

            "settings": {
                "extensions": {
                    "autoCheckUpdates": false,
                    "ignoreRecommandations": true,
                    "showRecommendationsOnlyOnDemand": true
                },

                "git": {
                    "ignoreMissingGitWarning": true
                },

                "json": {
                    "validate": {
                        "enable": false
                    }
                }
             }
        }
    }
}
