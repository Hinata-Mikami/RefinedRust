opam-version: "2.0"
synopsis: "SMTCoq integration for RefinedRust"
homepage: "https://gitlab.mpi-sws.org/lgaeher/refinedrust-dev"
bug-reports: "https://gitlab.mpi-sws.org/lgaeher/refinedrust-dev"
maintainer: "RefinedRust contributors"
authors: "RefinedRust contributors"
license: "BSD-3-Clause"

depends: [
  "refinedrust" {= version}
  # smtcoq and dependencies
  "rocq-metarocq-template" {(= "1.4.1+9.1")}
  "rocq-metarocq-utils" {(= "1.4.1+9.1")}
  "coq-sniper" {(= "dev")}
  "rocq-trakt" {(= "dev")}
  "rocq-smtcoq" {(= "dev")}
]

pin-depends: [
	["coq-sniper.dev" "git+https://github.com/smtcoq/sniper.git#8771b62d63f5f8d98de745d0e5a4f7fea1322f31"]
	["rocq-smtcoq.dev" "git+https://github.com/smtcoq/smtcoq#53f7fca859b48cbe24973755b4c06762103da07d"]
	["rocq-trakt.dev" "git+https://github.com/rocq-trakt/trakt#abc90bb42fdb6de022375187d8b0bacd63641c90"]
]

build: [
  ["dune" "subst"] {pinned}
  ["dune" "build" "-p" name "-j" jobs]
]
