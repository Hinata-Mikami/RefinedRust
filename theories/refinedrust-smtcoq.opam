opam-version: "2.0"
synopsis: "SMTCoq integration for RefinedRust"
homepage: "https://gitlab.mpi-sws.org/lgaeher/refinedrust-dev"
bug-reports: "https://gitlab.mpi-sws.org/lgaeher/refinedrust-dev"
maintainer: "RefinedRust contributors"
authors: "RefinedRust contributors"
license: "BSD-3-Clause"

depends: [
  "refinedrust" {= version}
  # smtcoq and dependencies
  "rocq-metarocq-template" {(= "1.4.1+9.1")}
	"rocq-metarocq-utils" {(= "1.4.1+9.1")}
  "coq-sniper" {(= "dev")}
	"rocq-trakt" {(= "dev")}
	"coq-smtcoq" {(= "dev")}
]

pin-depends: [
	["coq-sniper.dev" "git+https://github.com/smtcoq/sniper.git#c1ba4e90eea5af636de15c53a3e0a8ab29442a29"]
	["coq-smtcoq.dev" "git+https://github.com/smtcoq/smtcoq#3df6204826a06f5025bc7408ab77855680c50367"]
	["rocq-trakt.dev" "git+https://github.com/rocq-trakt/trakt#c666cad53d794b0facecb7a87a6f74e6c89be088"]
]

build: [
  ["dune" "subst"] {pinned}
  ["dune" "build" "-p" name "-j" jobs]
]
