opam-version: "2.0"
name: "refinedrust"
synopsis: "RefinedRust verification framework"
homepage: "https://gitlab.mpi-sws.org/lgaeher/refinedrust-dev"
bug-reports: "https://gitlab.mpi-sws.org/lgaeher/refinedrust-dev"
maintainer: "RefinedRust contributors"
authors: "RefinedRust contributors"
description: """
RefinedRust is a prototype framework for verifying safe and unsafe Rust code.
"""
license: "BSD-3-Clause"

depends: [
  "rocq-core" { (= "9.1.0" ) }
  "rocq-stdlib" { (= "9.0.0") }
  "rocq-stdpp"
  "rocq-stdpp-unstable"
  "rocq-stdpp-bitvector"
  "rocq-iris"
  "rocq-iris-contrib"
  "coq-lifetime-logic"
  "dune" {>= "3.21.0"}
  "rocq-equations" { (= "1.3.1+9.1") }
]

pin-depends: [
  ["rocq-stdpp.dev" "git+https://gitlab.mpi-sws.org/iris/stdpp.git#ad890e18391e7f0a3675c7f257519d9e3dbc36c1"]
  ["rocq-stdpp-unstable.dev" "git+https://gitlab.mpi-sws.org/iris/stdpp.git#ad890e18391e7f0a3675c7f257519d9e3dbc36c1"]
  ["rocq-stdpp-bitvector.dev" "git+https://gitlab.mpi-sws.org/iris/stdpp.git#ad890e18391e7f0a3675c7f257519d9e3dbc36c1"]
  ["rocq-iris.dev" "git+https://gitlab.mpi-sws.org/iris/iris.git#b0482dbb04dc8a87fa719bf3317f2b0ad4f4b995"]
  ["rocq-iris-contrib.dev" "git+https://gitlab.mpi-sws.org/iris/iris-contrib.git#809f20037565ace0f54903d9c560ead91a6ed538"]
  ["coq-lifetime-logic.dev" "git+https://gitlab.mpi-sws.org/iris/lambda-rust.git#2d20dc5def11269b2c4ef17f43a3dddd54f3bb46"]
]

build: [
  ["dune" "subst"] {pinned}
  ["dune" "build" "-p" name "-j" jobs]
]
