opam-version: "2.0"
name: "refinedrust"
synopsis: "RefinedRust verification framework"
homepage: "https://gitlab.mpi-sws.org/lgaeher/refinedrust-dev"
bug-reports: "https://gitlab.mpi-sws.org/lgaeher/refinedrust-dev"
maintainer: "RefinedRust contributors"
authors: "RefinedRust contributors"
description: """
RefinedRust is a prototype framework for verifying safe and unsafe Rust code.
"""
license: "BSD-3-Clause"

depends: [
  "rocq-core" { (= "9.1.1" ) }
  "rocq-stdlib" { (= "9.0.0") }
  "rocq-stdpp"
  "rocq-stdpp-unstable"
  "rocq-stdpp-bitvector"
  "rocq-iris"
  "rocq-iris-contrib"
  "coq-lifetime-logic"
  "dune" {>= "3.21.0"}
  "rocq-equations" { (= "1.3.1+9.1") }
]

pin-depends: [
  ["rocq-stdpp.dev" "git+https://gitlab.mpi-sws.org/iris/stdpp.git#2301f95c0bf0c336b64d9f0d6cb26668ce35fd8c"]
  ["rocq-stdpp-unstable.dev" "git+https://gitlab.mpi-sws.org/iris/stdpp.git#2301f95c0bf0c336b64d9f0d6cb26668ce35fd8c"]
  ["rocq-stdpp-bitvector.dev" "git+https://gitlab.mpi-sws.org/iris/stdpp.git#2301f95c0bf0c336b64d9f0d6cb26668ce35fd8c"]
  ["rocq-iris.dev" "git+https://gitlab.mpi-sws.org/iris/iris.git#aa39151cf17dbfd53649a4466a6420c3dbb02a96"]
  ["rocq-iris-contrib.dev" "git+https://gitlab.mpi-sws.org/iris/iris-contrib.git#35ebb0772e832eb535b20c6195375ec593c9081b"]
  ["coq-lifetime-logic.dev" "git+https://gitlab.mpi-sws.org/iris/lambda-rust.git#804c0168f773731b669110872bd72e6cce05e755"]
]

build: [
  ["dune" "subst"] {pinned}
  ["dune" "build" "-p" name "-j" jobs]
]
